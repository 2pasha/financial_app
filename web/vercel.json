{
  "framework": "vite",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/mtr/static/(.*)", "destination": "https://eu-assets.i.posthog.com/static/$1" },
    { "source": "/mtr/(.*)", "destination": "https://eu.i.posthog.com/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
