{
  "framework": "vite",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/mtr/static/:path*", "destination": "https://eu-assets.i.posthog.com/static/:path*" },
    { "source": "/mtr/:path*", "destination": "https://eu.i.posthog.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
